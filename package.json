{
  "name": "website-steadfast",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "backup:project": "node scripts/backup-project.mjs",
    "backup:storage-report": "node scripts/backup-storage-report.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "preview": "vite preview",
    "test": "npm run test:tier1",
    "test:tier1": "vitest run src/tests/sessionAuthorization.integration.test.ts --config vitest.integration.config.ts",
    "test:tier2": "vitest run src/tests/api.integration.test.ts --config vitest.integration.config.ts",
    "test:tier2:origin": "vitest run src/tests/originVariants.integration.test.ts --config vitest.integration.config.ts",
    "test:tier2:endpoints": "vitest run src/tests/endpointInventory.integration.test.ts --config vitest.integration.config.ts",
    "test:tier2:withdrawals": "vitest run src/tests/api.integration.test.ts --config vitest.integration.config.ts -t \"me/withdrawals|withdrawals/request\"",
    "test:tier2:transactions": "vitest run src/tests/api.integration.test.ts --config vitest.integration.config.ts -t \"me/transactions\"",
    "test:tier3": "vitest run --testTimeout=60000",
    "test:predeploy:admin": "node scripts/require-admin-test-jwt.mjs",
    "test:predeploy": "npm run verify:env:alignment && npm run validate:guardrails && npm run audit:constants && npm run detect:tdz && npm run test:tier1 && npm run test:tier2 && npm run test:tier2:origin && npm run test:tier2:endpoints && npm run test:predeploy:admin && npm run test:predeploy:admin-smoke && npm run test:predeploy:admin-platform-users && npm run test:predeploy:realtime && npm run audit:endpoints && npm run test:tier3",
    "test:predeploy:admin-smoke": "node scripts/admin-endpoint-smoke.mjs",
    "test:predeploy:admin-platform-users": "node scripts/admin-platform-users-regression.mjs",
    "reconcile:users:tasksets:dry": "node scripts/reconcile-platform-users-tasksets.mjs --dry-run",
    "reconcile:users:tasksets": "node scripts/reconcile-platform-users-tasksets.mjs --apply",
    "reconcile:users:tasksets:secure": "powershell -ExecutionPolicy Bypass -File scripts/reconcile-platform-users-tasksets.ps1",
    "kill-switch": "node scripts/kill-switch.mjs",
    "test:predeploy:realtime": "node scripts/realtime-smoke-gate.mjs",
    "test:integration": "vitest run --config vitest.config.ts src/tests/api.integration.test.ts",
    "test:all": "vitest run --exclude ''",
    "test:watch": "vitest",
    "audit:endpoints": "node scripts/api-endpoint-audit.mjs",
    "audit:constants": "node scripts/audit-constant-references.mjs",
    "smoke": "node scripts/api-smoke-test.mjs",
    "detect:tdz": "node scripts/detect-temporal-dead-zone.mjs",
    "validate:guardrails": "node scripts/validate-platform-guardrails.mjs",
    "deploy:env:audit:pre": "node scripts/record-deploy-env.mjs --phase pre",
    "deploy:env:audit:post": "node scripts/record-deploy-env.mjs --phase post",
    "verify:live:version": "node scripts/verify-live-version.mjs",
    "verify:env:alignment": "node scripts/verify-environment-alignment.mjs",
    "verify:live:version:routes": "node scripts/verify-live-version.mjs --verify-route-health true",
    "monitoring:check-stale": "node scripts/verify-live-version.mjs --fail-on-stale",
    "verify:deploy:p4": "node scripts/verify-cloudflare-deploy.mjs --project website-steadfast",
    "chat:worker:dev": "npm --prefix realtime-chat-worker run dev",
    "chat:worker:check": "npm --prefix realtime-chat-worker run check",
    "chat:worker:migrate": "npm --prefix realtime-chat-worker run d1:migrate",
    "chat:worker:migrate:local": "npm --prefix realtime-chat-worker run d1:migrate:local",
    "chat:worker:deploy": "npm --prefix realtime-chat-worker run deploy",
    "chat:worker:tail": "npm --prefix realtime-chat-worker run tail",
    "chat:worker:validate": "node scripts/validate-realtime-chat.mjs",
    "deploy:supabase:hardened": "powershell -ExecutionPolicy Bypass -File scripts/deploy-supabase-hardened.ps1",
    "deploy:supabase:hardened:smoke": "powershell -ExecutionPolicy Bypass -File scripts/deploy-supabase-hardened.ps1 -RunSmoke",
    "deploy:supabase:strict": "powershell -ExecutionPolicy Bypass -File scripts/deploy-supabase-hardened.ps1 -ExpectedProductionFunction make-server-a1c55d7e",
    "rollback:supabase:last-good": "powershell -ExecutionPolicy Bypass -File scripts/rollback-supabase.ps1",
    "synthetic:health": "node scripts/synthetic/api-health-probe.mjs",
    "synthetic:frontend": "node scripts/synthetic/frontend-probe.mjs",
    "synthetic:auth": "node scripts/synthetic/auth-flow.mjs",
    "synthetic:journeys": "node scripts/synthetic/user-journey-financial.mjs",
    "synthetic:all": "node scripts/synthetic/run-all.mjs",
    "synthetic:p0": "node scripts/synthetic/run-all.mjs --tier p0",
    "synthetic:p1": "node scripts/synthetic/run-all.mjs --tier p1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "@tanstack/react-virtual": "^3.13.23",
    "framer-motion": "^12.38.0",
    "i18next": "^26.0.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^17.0.2",
    "react-router": "7.13.0",
    "sonner": "2.0.3",
    "web-vitals": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^4.1.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "4.1.12",
    "typescript": "^6.0.2",
    "vite": "6.3.5",
    "vitest": "^4.1.0",
    "wrangler": "^4.78.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
