{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "backup:project": "node scripts/backup-project.mjs",
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "npm run test:tier1",
    "test:tier1": "vitest run src/tests/sessionAuthorization.integration.test.ts --testTimeout=60000",
    "test:tier2": "vitest run src/tests/api.integration.test.ts --testTimeout=60000",
    "test:tier2:endpoints": "vitest run src/tests/endpointInventory.integration.test.ts",
    "test:tier2:withdrawals": "vitest run src/tests/api.integration.test.ts -t \"me/withdrawals|withdrawals/request\"",
    "test:tier2:transactions": "vitest run src/tests/api.integration.test.ts -t \"me/transactions\"",
    "test:tier3": "vitest run --testTimeout=60000",
    "test:predeploy:admin": "node scripts/require-admin-test-jwt.mjs",
    "test:predeploy": "npm run test:tier1 && npm run test:tier2 && npm run test:tier2:endpoints && npm run test:predeploy:admin && npm run audit:endpoints && npm run test:tier3",
    "test:integration": "vitest run src/tests/api.integration.test.ts",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "audit:endpoints": "node scripts/api-endpoint-audit.mjs",
    "smoke": "node scripts/api-smoke-test.mjs",
    "verify:live:version": "node scripts/verify-live-version.mjs",
    "monitoring:check-stale": "node scripts/verify-live-version.mjs --fail-on-stale",
    "verify:deploy:p4": "node scripts/verify-cloudflare-deploy.mjs --project website-steadfast",
    "deploy:supabase:hardened": "powershell -ExecutionPolicy Bypass -File scripts/deploy-supabase-hardened.ps1",
    "deploy:supabase:hardened:smoke": "powershell -ExecutionPolicy Bypass -File scripts/deploy-supabase-hardened.ps1 -RunSmoke",
    "deploy:supabase:strict": "powershell -ExecutionPolicy Bypass -File scripts/deploy-supabase-hardened.ps1 -ExpectedProductionFunction make-server-a1c55d7e",
    "rollback:supabase:last-good": "powershell -ExecutionPolicy Bypass -File scripts/rollback-supabase.ps1"
  },
