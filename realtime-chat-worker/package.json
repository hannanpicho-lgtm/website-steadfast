{
  "name": "realtime-chat-worker",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --remote",
    "d1:migrate": "wrangler d1 migrations apply CHAT_DB --remote",
    "d1:migrate:local": "wrangler d1 migrations apply CHAT_DB --local",
    "tail": "wrangler tail",
    "check": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "wrangler": "^4.42.0"
  }
}
