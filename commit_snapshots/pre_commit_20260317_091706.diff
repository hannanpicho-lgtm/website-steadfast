+  const trimmed = value.trim();
+  if (!trimmed || trimmed.length > 256 || /[\u0000-\u001F]/.test(trimmed)) {
+    return null;
+  }
+  return trimmed;
+}
+
+function sanitizeFinanceMethod(value: unknown, fallback: string): string {
+  if (typeof value !== 'string') {
